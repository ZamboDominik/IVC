<Window x:Class="IVC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IVC"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <StackPanel Margin="20">
        <CheckBox x:Name="chkMutat" Content="Részletek megjelenítése" IsChecked="True"/>

        
        <TextBlock Text="Ez egy rejtett/látható szöveg!" 
                   Margin="0,10,0,0"
                   Visibility="{Binding ElementName=chkMutat, Path=IsChecked, Converter={StaticResource BoolToVis}}"/>
    </StackPanel>
</Window>
